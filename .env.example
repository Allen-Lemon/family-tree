# Root compose.yaml: external MySQL deployment. Copy to .env, never commit credentials.
COMPOSE_PROJECT_NAME=family-tree
IMAGE_TAG=local
# Debian runtime avoids recent Alpine/musl incompatibility on older container hosts.
NGINX_IMAGE=nginx:stable-bookworm
TZ=Asia/Shanghai

# Bind locally by default. Set HTTP_BIND=0.0.0.0 only when remote access is intended.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# Existing database: no local MySQL container and no database reset.
DB_URL=jdbc:mysql://42.193.151.196:3306/family_tree?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=REQUIRED&connectTimeout=10000&socketTimeout=60000
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_EXISTING_DATABASE_PASSWORD

# Keep these values from the current installation, especially the encryption key!
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_EXISTING_BOOTSTRAP_PASSWORD
APP_DATA_ENCRYPTION_KEY=CHANGE_ME_KEEP_EXISTING_ENCRYPTION_KEY
SESSION_COOKIE_SECURE=false

# Relative to root compose.yaml. Reuse existing files; not copied into the image.
UPLOADS_PATH=./data/uploads
MAX_UPLOAD_SIZE=20MB
MAX_UPLOAD_BYTES=20971520

# Disabled unless explicitly configured and approved.
OCR_ENABLED=false
OCR_PROVIDER=disabled
OCR_ENDPOINT=
OCR_API_KEY=
CLAMAV_ENABLED=false
