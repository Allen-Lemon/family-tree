# Copy to .env and replace every CHANGE_ME value before starting.
COMPOSE_PROJECT_NAME=family-tree
TZ=Asia/Shanghai

# Published ports
HTTP_PORT=80
BACKEND_PORT=8080

# MySQL 8.4
MYSQL_DATABASE=family_tree
MYSQL_USER=family_tree
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

# Initial administrator (used only by backend bootstrap logic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.invalid

# Application security
# Used to protect/encrypt server-side application data; never expose it to browsers.
APP_DATA_ENCRYPTION_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=http://localhost
SESSION_COOKIE_SECURE=false

# OCR: outbound OCR is disabled by default. Enable only after security review.
OCR_ENABLED=false
OCR_PROVIDER=disabled
OCR_ENDPOINT=
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=30

# Upload limits and malware scanning
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_BYTES=20971520
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
